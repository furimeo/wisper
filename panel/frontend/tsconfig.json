{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": true,

    "types": ["vite/client", "node"],
    // Relative, and no baseUrl: paths resolve against this file's own directory, which is
    // the only form TypeScript 7 accepts. It has meant the same thing since 4.4, so this
    // is not a version-gated spelling - the old one was just the older habit.
    "paths": {"@/*": ["./src/*"]}
  },
  "include": ["src", "vite.config.ts"]
}
